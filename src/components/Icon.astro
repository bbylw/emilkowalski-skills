---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
---

<span
  class:list={['icon', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
  set:html={icons[name]}
/>

<style>
  .icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
  }
</style>
