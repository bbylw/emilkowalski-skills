---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="页面不存在">
  <section class="nf">
    <div class="shell nf__inner">
      <p class="nf__code num">404</p>
      <h1 class="nf__title">这个地址没有内容</h1>
      <p class="nf__body">
        链接可能已经改动，或者从来就不存在。回首页看概览，或者直接进组合手册挑一条流水线。
      </p>
      <div class="nf__links">
        <a class="btn btn-primary" href="/">回到首页</a>
        <a class="btn btn-ghost" href="/playbook">
          看组合手册
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(88px, 12vw, 140px) clamp(96px, 12vw, 150px);
  }

  .nf__inner {
    max-width: 56ch;
  }

  /* 404 是真实的错误码，让它在版面上占足分量，而不是一行小号灰字 */
  .nf__code {
    font-family: var(--font-mono);
    font-size: clamp(56px, 9vw, 104px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .nf__title {
    margin-top: 18px;
    font-size: clamp(30px, 4.5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .nf__body {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--muted);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
</style>
