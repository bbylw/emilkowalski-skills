---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionRace from '../components/MotionRace.astro';
import CompareRows from '../components/CompareRows.astro';
import SkillBrowser from '../components/SkillBrowser.astro';
import ComboConsole from '../components/ComboConsole.astro';
import CopyButton from '../components/CopyButton.astro';
import { site } from '../data/site';
import { skills } from '../data/skills';
import { siVercel, siLinear, siApple, siExpo, siSwift } from 'simple-icons';

const logos = [siVercel, siLinear, siApple, siExpo, siSwift];
---

<Base>
  <!-- 1. Hero -->
  <section class="hero">
    <svg class="hero__arc" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
      <!-- 一条放大的 ease-out 曲线：全站母题在页首的投影 -->
      <path d="M0 400 C 320 400, 540 30, 1200 10" pathLength="1" />
    </svg>
    <div class="shell hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title">
          <span class="hero__line"><span class="hero__line-in">给智能体</span></span>
          <span class="hero__line"><span class="hero__line-in hero__line-in--2">补上<span class="hero__accent">品味<svg class="hero__swoosh" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 11 C 34 12, 74 4, 118 2" pathLength="1" /></svg></span></span></span>
        </h1>
        <p class="hero__sub">
          {skills.length} 个 skill 把动效与界面的判断标准写清楚，让 AI 不再临场发挥。
        </p>
        <div class="hero__cta">
          <a class="btn btn-primary" href="#install">安装 skills</a>
          <a class="btn btn-ghost" href="/playbook">看组合手册</a>
        </div>
      </div>

      <div class="hero__device">
        <MotionRace />
      </div>
    </div>
  </section>

  <!-- 2. 出处 -->
  <section class="band prov">
    <div class="shell prov__inner">
      <p class="label prov__label">经验沉淀自</p>
      <ul class="prov__logos">
        {
          logos.map((logo) => (
            <li>
              <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" role="img" aria-label={logo.title}>
                <path d={logo.path} />
              </svg>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. 对照 -->
  <section class="band sec">
    <div class="shell taste">
      <div class="taste__lead reveal">
        <h2 class="taste__title">智能体缺的不是能力，是品味</h2>
        <p class="taste__body">
          智能体在为某一处动效挑选配料时常常选错：本该用 ease-out 的入场，却配了 ease-in；本该用半透明阴影建立层级，却给了一圈实色描边。
        </p>
        <p class="taste__body">
          这些细节会不断累积，最后决定你的界面是惊艳，还是平平无奇。下面三处是最常见的错法，右边是同一件事的另一种做法。
        </p>
        <a class="link-underline taste__link" href="/skills/emil-design-eng">
          阅读总纲里的规则
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="taste__rows">
        <CompareRows />
      </div>
    </div>
  </section>

  <!-- 4. 引文 -->
  <section class="band quote">
    <div class="shell quote__inner reveal">
      <span class="quote__mark" aria-hidden="true">「</span>
      <blockquote class="quote__text">
        去学编程、学设计，或在任何其他领域沉淀专业能力吧。AI 不会取代这种专业能力，它只会放大你能从中获得的成果。
      </blockquote>
      <p class="quote__by">Emil Kowalski · skills 作者</p>
    </div>
  </section>

  <!-- 5. Skills 浏览 -->
  <section class="band sec">
    <div class="shell">
      <header class="sec__head reveal">
        <div>
          <p class="eyebrow">共 {skills.length} 个</p>
          <h2 class="sec__title">一个 skill 只管一段事</h2>
        </div>
        <p class="sec__body">
          它们合起来覆盖了从立意、构建、审查到收尾的整条链路。点开任意一个，看它具体做什么、该在什么时候叫它。
        </p>
      </header>

      <div class="sec__wide">
        <SkillBrowser />
      </div>

      <p class="sec__more">
        <a class="link-underline" href="/skills">打开完整列表</a>
      </p>
    </div>
  </section>

  <!-- 6. 组合 -->
  <section class="band sec">
    <div class="shell">
      <header class="sec__head reveal">
        <div>
          <h2 class="sec__title">单独用是技巧，串起来才是流程</h2>
        </div>
        <p class="sec__body">
          单个 skill 只解决链条上的一段。差距出现在你把它们接起来的时候：先把需求说准，再做出来，最后按同一套规则检查一遍。选一个场景，看这条链是怎么走的。
        </p>
      </header>

      <div class="sec__wide">
        <ComboConsole />
      </div>
    </div>
  </section>

  <!-- 7. 安装 -->
  <section class="band sec" id="install">
    <div class="shell">
      <header class="sec__head reveal">
        <div>
          <h2 class="sec__title">一条命令，全部就位</h2>
        </div>
        <p class="sec__body">
          装完之后，在你的智能体里直接说「用 animate 做这个展开」即可。不需要额外配置，也不需要记住这份清单。
        </p>
      </header>

      <div class="install">
        <div class="install__cmd">
          <p class="cmd">
            <span class="prompt">$</span>
            <span id="install-cmd">{site.install}</span>
          </p>
          <CopyButton from="#install-cmd" label="复制命令" />
        </div>

        <ul class="install__notes">
          <li>
            <p class="install__k">装在哪里</p>
            <p class="install__v">写入当前项目的 skills 目录，随代码一起进版本库，团队共享同一套标准。</p>
          </li>
          <li>
            <p class="install__k">什么时候生效</p>
            <p class="install__v">下次对话即可调用。提到 skill 名字，或直接描述你要做的事。</p>
          </li>
          <li>
            <p class="install__k">想跟进更新</p>
            <p class="install__v">
              <a class="link-underline" href={site.subscribe} target="_blank" rel="noreferrer">
                订阅作者的资讯简报</a
              >，新 skill 与改动都会第一时间发出来。
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    position: relative;
    padding-block: 48px 60px;
  }

  .hero__arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* 画完之后随滚动缓缓下沉淡出：母题让位给正文，而不是一直悬在首屏 */
    animation: hero-arc-drift linear both;
    animation-range: 0px 70vh;
  }

  /* 时间线单独一条更高特异度规则，防压缩器折进 animation 简写后 Chrome 解析作废 */
  body .hero__arc {
    animation-timeline: scroll(root);
  }

  @keyframes hero-arc-drift {
    to {
      transform: translateY(38px);
      opacity: 0;
    }
  }

  .hero__arc path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 2s cubic-bezier(0, 0, 0.2, 1) 0.15s forwards;
  }

  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
    align-items: center;
  }

  .hero__title {
    font-size: clamp(40px, 6.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.038em;
    font-weight: 500;
  }

  /* 逐行遮罩升起：行盒 overflow hidden，padding-bottom 给下划曲线留出可见区 */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }

  .hero__line-in {
    display: block;
    transform: translateY(135%);
    animation: hero-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
  }

  .hero__line-in--2 {
    animation-delay: 0.2s;
  }

  @keyframes hero-rise {
    to {
      transform: none;
    }
  }

  .hero__accent {
    position: relative;
    color: var(--accent-ink);
  }

  .hero__swoosh {
    position: absolute;
    left: -2%;
    bottom: -0.14em;
    width: 104%;
    height: 0.3em;
    overflow: visible;
  }

  .hero__swoosh path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 0.7s cubic-bezier(0, 0, 0.58, 1) 0.85s forwards;
  }

  /* 悬停「品味」二字时重画下划线：签名时刻可以再叫一次 */
  @media (hover: hover) {
    .hero__accent:hover .hero__swoosh path {
      animation: hero-swoosh-redraw 0.55s cubic-bezier(0, 0, 0.58, 1);
    }
  }

  @keyframes hero-swoosh-redraw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__accent:hover .hero__swoosh path {
      animation: none;
    }
  }

  .hero__sub {
    margin-top: 22px;
    max-width: 31ch;
    font-size: clamp(15px, 1.4vw, 17.5px);
    line-height: 1.68;
    color: var(--muted);
    opacity: 0;
    transform: translateY(14px);
    animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.42s forwards;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
    opacity: 0;
    transform: translateY(14px);
    animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.54s forwards;
  }

  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__device {
    opacity: 0;
    transform: translateY(20px) scale(0.99);
    animation: hero-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__arc {
      transform: none;
      opacity: 1;
      animation: none;
    }

    .hero__line-in,
    .hero__sub,
    .hero__cta,
    .hero__device {
      transform: none;
      opacity: 1;
      animation: none;
    }

    .hero__arc path,
    .hero__swoosh path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  /* ---- 出处 ---- */
  .prov {
    padding-block: 24px;
  }

  .prov__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  /* 标签与标记之间用发丝线隔开，代替再加一个装饰符号 */
  .prov__label {
    margin: 0;
    flex: none;
    padding-right: 20px;
    border-right: 1px solid var(--line);
  }

  .prov__logos {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .prov__logos li {
    color: var(--muted);
    transition: color 0.18s ease;
  }

  @media (hover: hover) {
    .prov__logos li:hover {
      color: var(--ink);
    }
  }

  .prov__logos svg {
    display: block;
  }

  /* ---- 通用分节 ---- */
  .sec {
    padding-block: var(--sec-y);
  }

  .sec__head {
    display: grid;
    gap: 16px;
    margin-bottom: 44px;
    max-width: 62ch;
  }

  .sec__title {
    margin-top: 12px;
    font-size: clamp(28px, 3.8vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.032em;
  }

  .sec__head h2:first-child {
    margin-top: 0;
  }

  .sec__body {
    font-size: 14.5px;
    line-height: 1.78;
    color: var(--muted);
    max-width: 58ch;
  }

  .sec__more {
    margin-top: 30px;
    font-size: 14px;
  }

  /* ---- 对照 ---- */
  .taste {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .taste__title {
    margin-top: 12px;
    font-size: clamp(28px, 3.8vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.032em;
  }

  .taste__lead .taste__title:first-child {
    margin-top: 0;
  }

  .taste__body {
    margin-top: 18px;
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 40ch;
  }

  .taste__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 24px;
    font-size: 14px;
    color: var(--ink);
  }

  .taste__link :global(.icon) {
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .taste__link:hover :global(.icon) {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .taste__link:hover :global(.icon) {
      transform: none;
    }
  }

  /* ---- 引文 ---- */
  .quote {
    padding-block: clamp(72px, 9vw, 116px);
  }

  .quote__inner {
    display: grid;
    gap: 22px;
  }

  .quote__mark {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.6;
    font-weight: 500;
    color: var(--accent);
    margin-left: 24px;
  }

  .quote__text {
    margin: 0;
    max-width: 30ch;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-size: clamp(25px, 3.6vw, 42px);
    line-height: 1.3;
    letter-spacing: -0.026em;
    font-weight: 450;
    text-wrap: balance;
  }

  /* 署名前的短横线，把"谁说的"和"说了什么"接起来 */
  .quote__by {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .quote__by::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--accent);
  }

  /* ---- 安装 ---- */
  .install {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .install__cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .install__cmd .cmd {
    flex: 1 1 320px;
  }

  /* 三条说明用发丝线分节，不堆成三张卡片 */
  .install__notes {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .install__notes li + li {
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .install__k {
    font-size: 14px;
    font-weight: 500;
  }

  .install__v {
    margin-top: 5px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 72px 96px;
    }

    .hero__grid {
      grid-template-columns: 1.04fr 1fr;
      gap: 60px;
    }

    .taste {
      grid-template-columns: 4fr 8fr;
      gap: 52px;
    }

    .taste__lead {
      position: sticky;
      top: 104px;
      align-self: start;
    }

    .quote__inner {
      padding-left: 8vw;
    }

    .install {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: start;
    }
  }
</style>
